<Project>
   <!-- CUDAVersion is auto-detected by the DetectCudaVersion target in
        Directory.Build.targets (parses the output of `nvcc -V`). Override
        here, on the MSBuild command line, or via env var only when you need
        to pin a specific toolkit on a host that has several installed. -->

  <PropertyGroup>
    <!-- On Windows, $(CUDA_PATH) is provided by the CUDA installer env var.
         On Linux, /usr/local/cuda is the canonical symlink. -->
    <CUDA_PATH Condition="'$(OS)' != 'Windows_NT' And '$(CUDA_PATH)' == ''">/usr/local/cuda</CUDA_PATH>

    <!-- CCCL (cub, cuda, thrust, nv) moved under include/cccl in CUDA 13.
         nvcc auto-adds an -isystem on the cccl subdir, but NVRTC (used by
         hybridizer for JIT compilation) does not, so any sample whose
         intrinsics.cuh pulls in cub or cuda libcu++ headers needs this on
         the JIT include path. Falls back to include on CUDA 12 and earlier. -->
    <CudaCcclIncludeDir Condition="Exists('$(CUDA_PATH)/include/cccl')">$(CUDA_PATH)/include/cccl</CudaCcclIncludeDir>
    <CudaCcclIncludeDir Condition="'$(CudaCcclIncludeDir)' == ''">$(CUDA_PATH)/include</CudaCcclIncludeDir>
  </PropertyGroup>

  <!-- The GPU the samples are built for. CUDA, or METAL on macOS, which has no CUDA: Apple GPUs run the Metal
       Shading Language Hybridizer generates (Hybridizer.Metal.targets). -p:HybridizerFlavor=CUDA overrides it. -->
  <PropertyGroup>
    <HybridizerFlavor Condition="'$(HybridizerFlavor)' == '' And $([MSBuild]::IsOSPlatform('OSX'))">METAL</HybridizerFlavor>
    <HybridizerFlavor Condition="'$(HybridizerFlavor)' == ''">CUDA</HybridizerFlavor>
  </PropertyGroup>

  <!-- HybridizerDir: a build of hybridizer-software-suite (the runtime and the transcoder built into one directory,
       see README.md), which then replaces the Hybridizer.Runtime.CUDAImports package; for METAL, its transcoder
       replaces the hybridizer dotnet tool too. The samples need it as long as no published package has the
       backend-agnostic GPU API they use (gpu.*, HybRunner.Create) and the METAL backend. -->
  <PropertyGroup Condition="'$(HybridizerDir)' != ''">
    <!-- HybridizerDir as given (a global property cannot be changed), _HybridizerDir with its full path and a slash -->
    <_HybridizerDir>$([MSBuild]::EnsureTrailingSlash('$([System.IO.Path]::GetFullPath('$(HybridizerDir)'))'))</_HybridizerDir>
    <!-- CUDA keeps the tool: CompileCUDA builds what its transcoder, the Essentials one, writes -->
    <HybridizerTranscoder Condition="'$(HybridizerTranscoder)' == '' And '$(HybridizerFlavor)' == 'METAL'">dotnet "$(_HybridizerDir)Hybridizer.Application.dll"</HybridizerTranscoder>
  </PropertyGroup>
  <PropertyGroup>
    <!-- the command that transcodes, which GenerateCUDA and GenerateMETAL run -->
    <HybridizerTranscoder Condition="'$(HybridizerTranscoder)' == ''">hybridizer</HybridizerTranscoder>
  </PropertyGroup>
</Project>
